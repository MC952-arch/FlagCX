FROM harbor.sourcefind.cn:5443/dcu/admin/base/vllm:0.15.1-ubuntu22.04-dtk26.04-py3.10

SHELL ["/bin/bash", "-c"]

ARG FLAGCX_COMMIT=cec23fd46b170f291912a8f76f4e8e06875abb67
ENV FLAGCX_ROOT=/workspace/FlagCX \
    FLAGCX_ADAPTOR=du \
    USE_DU=1 \
    MPI_HOME=/opt/mpi \
    CUDA_PATH=/opt/dtk/cuda/cuda-12 \
    CUDA_HOME=/opt/dtk/cuda/cuda-12 \
    PATH=/opt/mpi/bin:/opt/dtk/cuda/cuda-12/bin:/opt/dtk/bin:/opt/dtk/llvm/bin:/opt/dtk/hip/bin:/opt/dtk/.hyhal/bin:${PATH} \
    LD_LIBRARY_PATH=/workspace/FlagCX/build/lib:/opt/dtk/cuda/cuda-12/lib64:/opt/dtk/.hyhal/rocm_smi/lib:/opt/dtk/lib:/opt/dtk/lib64:/opt/dtk/hip/lib:/opt/dtk/llvm/lib:/opt/hyhal/lib:/opt/hyhal/lib64:/opt/dtk/dushmem/lib:/opt/dtk/opencl/lib:/opt/ucx/lib:/opt/mpi/lib:/opt/hwloc/lib:${LD_LIBRARY_PATH}

WORKDIR /workspace
COPY . /workspace/FlagCX

RUN set -eux; \
    . /opt/dtk/env.sh; \
    export CUDA_PATH=/opt/dtk/cuda/cuda-12; \
    export CUDA_HOME=/opt/dtk/cuda/cuda-12; \
    export FLAGCX_ADAPTOR=du; \
    export USE_DU=1; \
    ln -sfn "${CUDA_PATH}" /usr/local/cuda; \
    cp -a /workspace/FlagCX /tmp/FlagCX-build; \
    cd /tmp/FlagCX-build; \
    make USE_DU=1 PLATFORM_EXTRA_SRCS=flagcx/adaptor/device_api/default_dev_api_backend.cc -j"$(nproc)"; \
    make USE_DU=1 PLATFORM_EXTRA_SRCS=flagcx/adaptor/device_api/default_dev_api_backend.cc install; \
    rm -rf /workspace/FlagCX/build; \
    cp -a /tmp/FlagCX-build/build /workspace/FlagCX/build; \
    cmake -S /workspace/FlagCX/third-party/googletest \
      -B /workspace/FlagCX/third-party/googletest/build \
      -DCMAKE_BUILD_TYPE=Release; \
    cmake --build /workspace/FlagCX/third-party/googletest/build --parallel "$(nproc)"; \
    printf '%s\n' "${FLAGCX_COMMIT}" > /workspace/FlagCX/.flagcx-commit

WORKDIR /workspace/FlagCX
CMD ["/bin/sh", "-c", "tail -f /dev/null"]
