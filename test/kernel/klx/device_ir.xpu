// ---------------------------------------------------------------------------
// S23: put variants with a sender-side counter — primary team + WORLD
// variant 0: LCtrInc only, 1: RSigInc + LCtrInc, 2: RSigAdd(3) + LCtrInc.
// The counter is local, so it must reach exactly 1 per (context, counter).
// ---------------------------------------------------------------------------
__global__ void kernelDevPutCounterUnifiedS(const flagcxDevComm *gComm,
                                            const flagcxDevMem *gDst,
                                            const flagcxDevMem *gSrc,
                                            int *result, int bytes,
                                            bool useInter) {
  FLAGCX_IR_PROLOGUE(gComm);
  flagcxDevMem dst, src;
  GM2LM(gDst, &dst, sizeof(dst));
  GM2LM(gSrc, &src, sizeof(src));

  const int worldRank = comm.getRank();
  const int nRanks = comm.getSize();
  const IrPrimaryTeam primary = irPrimaryTeam(comm, useInter);
  bool ok = true;

#define S23_COMBO(slot, teamKind, peer)                                        \
  do {                                                                         \
    const flagcxDevCounter_t ctr = (flagcxDevCounter_t)(slot);                 \
    const flagcxDevSignal_t sig = (flagcxDevSignal_t)(slot);                   \
    const int variant = (slot) % 3;                                            \
    if (core_id() == 0) {                                                      \
      flagcxDevResetCounter(&comm, contextId, ctr);                            \
      flagcxDevResetSignal(&comm, contextId, sig);                             \
      if (flagcxDevReadCounter(&comm, ctr, 64, contextId,                      \
                               flagcxDeviceMemoryOrderAcquire) != 0 ||         \
          flagcxDevReadSignal(&comm, sig, 64, contextId,                       \
                              flagcxDeviceMemoryOrderAcquire) != 0)            \
        ok = false;                                                            \
    }                                                                          \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    flagcxDevBarrierSync(&comm, teamKind, cluster_id(), contextId,             \
                         FLAGCX_COOP_BLOCK, flagcxDeviceMemoryOrderAcqRel,     \
                         flagcxDeviceScopeSystem);                             \
    if (core_id() == 0) {                                                      \
      size_t off = (size_t)(slot) * (size_t)bytes;                             \
      if (variant == 0)                                                        \
        flagcxDevPut_LCtrInc(&comm, &dst, off, &src, off, (size_t)bytes,        \
                             teamKind, peer, contextId, FLAGCX_COOP_THREAD,    \
                             flagcxDeviceScopeSystem,                          \
                             flagcxDeviceMemoryOrderRelease, ctr);             \
      else if (variant == 1)                                                   \
        flagcxDevPut_RSigInc_LCtrInc(&comm, &dst, off, &src, off,               \
                                     (size_t)bytes, teamKind, peer, contextId, \
                                     FLAGCX_COOP_THREAD,                       \
                                     flagcxDeviceScopeSystem,                  \
                                     flagcxDeviceMemoryOrderRelease, sig, ctr);\
      else                                                                     \
        flagcxDevPut_RSigAdd_LCtrInc(&comm, &dst, off, &src, off,               \
                                     (size_t)bytes, teamKind, peer, contextId, \
                                     FLAGCX_COOP_THREAD,                       \
                                     flagcxDeviceScopeSystem,                  \
                                     flagcxDeviceMemoryOrderRelease, sig,      \
                                     (uint64_t)3, ctr);                        \
    }                                                                          \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    flagcxDevWaitCounter(&comm, ctr, 1, 64, contextId, FLAGCX_COOP_BLOCK,      \
                         flagcxDeviceMemoryOrderAcquire);                      \
    if (core_id() == 0 &&                                                      \
        flagcxDevReadCounter(&comm, ctr, 64, contextId,                        \
                             flagcxDeviceMemoryOrderAcquire) != 1)             \
      ok = false;                                                              \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    if (variant != 0) {                                                        \
      const uint64_t expectedSig = (variant == 1) ? 1 : 3;                     \
      flagcxDevWaitSignal(&comm, sig, expectedSig, 64, contextId,              \
                          FLAGCX_COOP_BLOCK,                                   \
                          flagcxDeviceMemoryOrderAcquire);                     \
      if (core_id() == 0 &&                                                    \
          flagcxDevReadSignal(&comm, sig, 64, contextId,                       \
                              flagcxDeviceMemoryOrderAcquire) != expectedSig)  \
        ok = false;                                                            \
      flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                      \
    }                                                                          \
  } while (0)

  S23_COMBO(0, primary.kind, (primary.rank + 1) % primary.size);
  S23_COMBO(1, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks);
  S23_COMBO(2, primary.kind, (primary.rank + 1) % primary.size);
  S23_COMBO(3, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks);
  S23_COMBO(4, primary.kind, (primary.rank + 1) % primary.size);
  S23_COMBO(5, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks);

#undef S23_COMBO

  irPublish(result, ok);
}

