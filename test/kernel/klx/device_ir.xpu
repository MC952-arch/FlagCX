/*************************************************************************
 * Copyright (c) 2026 BAAI. All rights reserved.
 *
 * Device IR kernels for Kunlunxin (P800), exercising the transport-transparent
 * one-sided IR (flagcxDev*) on top of the xSHMEM CommTraits.
 *
 * The unified INTRA and INTER suites (S16-S25) of
 * test/kernel/include/device_ir.h are provided. S19 (DevGet) is absent on
 * purpose: P800 cannot read a peer's memory, so no correct implementation
 * exists (see docs/device_ir_klx_adaptation.md).
 *
 * Two P800 properties shape every kernel here:
 *   - Kernel pointer parameters live in address space 1. The IR entry points
 *     take generic (const void *) handles, so each kernel copies the
 *     flagcxDevComm / flagcxDevMem descriptors into local memory first and
 *     passes the local objects in.
 *   - FLAGCX_COOP_WARP maps to CoopTile<FLAGCX_SIMT_WIDTH> == CoopTile<16>,
 *     which is the whole cluster at 16 cores. Launching with exactly 16 cores
 *     is therefore what makes WARP a legal (cluster-wide) barrier scope.
 ************************************************************************/

#include "bkcl.h"
#include "xpu/kernel/xtdk.h"
#include "xpu/kernel/xtdk_io.h"
#include "xpu/runtime.h"
#include "xshmem/xshmem.h"
#include "xshmem/xshmemx.h"

#include <stdio.h>

#include "flagcx.h"
#include "flagcx_kernel.h"

#include "device_api/flagcx_device.h"

// IR declarations + inline implementations.
#include "flagcx_device_wrapper.h"
#include "flagcx_device_wrapper_impl.h" // also pulls in scalar/unified IR impls

#include "device_ir.h"

// The suites check result[0..3], one slot per CTA, so the grid width is part of
// the contract. It must also stay constant for every launch on one DevComm:
// the xshmem grid barrier keeps a per-cluster generation counter in the
// symmetric heap.
#define FLAGCX_IR_CLUSTERS 4
// 16 cores == one full cluster == CoopWarp, see the file header.
#define FLAGCX_IR_CORES FLAGCX_SIMT_WIDTH


namespace {

// FLAGCX_COOP_WARP and FLAGCX_COOP_BLOCK both span the whole cluster on P800,
// so only THREAD narrows the participating cores. Mirrors
// flagcxUnifiedIrTestCoopActive in the CUDA kernels.
static __device__ inline bool irCoopActive(flagcxDevCoopKind_t coopKind) {
  return coopKind != FLAGCX_COOP_THREAD || core_id() == 0;
}

// P800 has no atomic AND, and none is needed: only zero is ever published, so
// a plain store from each failing core is equivalent to the CUDA kernels'
// atomicAnd(result, ok).
static __device__ inline void irPublish(_global_ptr_ int *result, bool ok) {
  if (!ok && core_id() == 0)
    result[0] = 0;
}

struct IrPrimaryTeam {
  flagcxDevTeamKind_t kind;
  int rank;
  int size;
};

// Both unified suites exercise a primary team plus WORLD. Keeping that choice
// as kernel data lets the INTRA and INTER launchers share exactly the same
// operation sequence instead of maintaining two large, subtly divergent
// kernels.
static __device__ inline IrPrimaryTeam irPrimaryTeam(const flagcxDevComm &comm,
                                                     bool useInter) {
  IrPrimaryTeam team;
  if (useInter) {
    team.kind = FLAGCX_TEAM_INTER;
    team.rank = comm.getRank() / comm.getIntraSize();
    team.size = comm.getSize() / comm.getIntraSize();
  } else {
    team.kind = FLAGCX_TEAM_INTRA;
    team.rank = comm.getIntraRank();
    team.size = comm.getIntraSize();
  }
  return team;
}

} // namespace

#if defined(__xpu_on_host__) || !defined(__xpu__)
namespace {
static flagcxResult_t irWait(XPUStream cs, const char *where) {
  int ret = xpu_wait(cs);
  if (ret != XPU_SUCCESS) {
    fprintf(stderr, "FlagCX KLX device_ir: xpu_wait failed at %s, code=%d\n",
            where, ret);
    return flagcxUnhandledDeviceError;
  }
  return flagcxSuccess;
}
} // namespace
#endif

// Every kernel opens the same way: stage the descriptors the test passes as
// device pointers into local memory, bring up the xshmem device state, and pick
// this cluster's net context (one context per cluster, so per-context signal
// slots never collide).
#define FLAGCX_IR_PROLOGUE(gComm)                                              \
  flagcxDevComm comm;                                                          \
  GM2LM(gComm, &comm, sizeof(comm));                                           \
  XSHMEM_DEVICE_INIT(comm._commBase.devStateHandle);                           \
  XSHMEM_DEVICE_SET_FLOW_CONTROL_THRESHOLD(cluster_num());                     \
  const int nContexts = comm.getContextCount();                                \
  const flagcxDevContext_t contextId =                                         \
      nContexts > 0 ? (flagcxDevContext_t)(cluster_id() % nContexts) : 0

// ---------------------------------------------------------------------------
// S16: flagcxDevBarrierSync — primary team then WORLD
// ---------------------------------------------------------------------------
__global__ void kernelDevBarrierUnifiedS(const flagcxDevComm *gComm,
                                         int *result, bool useInter) {
  FLAGCX_IR_PROLOGUE(gComm);
  const IrPrimaryTeam primary = irPrimaryTeam(comm, useInter);
  flagcxDevBarrierSync(&comm, primary.kind, cluster_id(), contextId,
                       FLAGCX_COOP_BLOCK, flagcxDeviceMemoryOrderAcqRel,
                       flagcxDeviceScopeSystem);
  flagcxCoopSyncS(FLAGCX_COOP_BLOCK);
  flagcxDevBarrierSync(&comm, FLAGCX_TEAM_WORLD, cluster_id(), contextId,
                       FLAGCX_COOP_BLOCK, flagcxDeviceMemoryOrderAcqRel,
                       flagcxDeviceScopeSystem);

  if (core_id() == 0)
    result[cluster_id()] = 1;
}

#if defined(__xpu_on_host__) || !defined(__xpu__)
void launchKernelDevBarrierIntraWorldS(const void *devCommPtr, int *devResult,
                                       flagcxStream_t stream) {
  XPUStream cs = (XPUStream)(*(void **)stream);
  kernelDevBarrierUnifiedS<<<FLAGCX_IR_CLUSTERS, FLAGCX_IR_CORES, cs>>>(
      (const flagcxDevComm *)devCommPtr, devResult, false);
  irWait(cs, "S16 DevBarrierSync");
}

void launchKernelDevBarrierInterWorldS(const void *devCommPtr, int *devResult,
                                       flagcxStream_t stream) {
  XPUStream cs = (XPUStream)(*(void **)stream);
  kernelDevBarrierUnifiedS<<<FLAGCX_IR_CLUSTERS, FLAGCX_IR_CORES, cs>>>(
      (const flagcxDevComm *)devCommPtr, devResult, true);
  irWait(cs, "S16 DevBarrierSync INTER");
}
#endif

// ---------------------------------------------------------------------------
// S16 sub-block: flagcxDevBarrierArrive + flagcxDevBarrierWait
// ---------------------------------------------------------------------------
__global__ void kernelDevBarrierArriveWaitUnifiedS(const flagcxDevComm *gComm,
                                                   int *result,
                                                   bool useInter) {
  FLAGCX_IR_PROLOGUE(gComm);
  const IrPrimaryTeam primary = irPrimaryTeam(comm, useInter);

  flagcxDevBarrierArrive(&comm, primary.kind, cluster_id(), contextId,
                         FLAGCX_COOP_BLOCK, flagcxDeviceMemoryOrderRelease,
                         flagcxDeviceScopeSystem);
  flagcxDevBarrierWait(&comm, primary.kind, cluster_id(), contextId,
                       FLAGCX_COOP_BLOCK, flagcxDeviceMemoryOrderAcquire,
                       flagcxDeviceScopeSystem);

  flagcxCoopSyncS(FLAGCX_COOP_BLOCK);

  flagcxDevBarrierArrive(&comm, FLAGCX_TEAM_WORLD, cluster_id(), contextId,
                         FLAGCX_COOP_BLOCK, flagcxDeviceMemoryOrderRelease,
                         flagcxDeviceScopeSystem);
  flagcxDevBarrierWait(&comm, FLAGCX_TEAM_WORLD, cluster_id(), contextId,
                       FLAGCX_COOP_BLOCK, flagcxDeviceMemoryOrderAcquire,
                       flagcxDeviceScopeSystem);

  if (core_id() == 0)
    result[cluster_id()] = 1;
}

#if defined(__xpu_on_host__) || !defined(__xpu__)
void launchKernelDevBarrierArriveWaitIntraWorldS(const void *devCommPtr,
                                                 int *devResult,
                                                 flagcxStream_t stream) {
  XPUStream cs = (XPUStream)(*(void **)stream);
  kernelDevBarrierArriveWaitUnifiedS<<<FLAGCX_IR_CLUSTERS, FLAGCX_IR_CORES,
                                       cs>>>(
      (const flagcxDevComm *)devCommPtr, devResult, false);
  irWait(cs, "S16 DevBarrierArriveWait");
}

void launchKernelDevBarrierArriveWaitInterWorldS(const void *devCommPtr,
                                                 int *devResult,
                                                 flagcxStream_t stream) {
  XPUStream cs = (XPUStream)(*(void **)stream);
  kernelDevBarrierArriveWaitUnifiedS<<<FLAGCX_IR_CLUSTERS, FLAGCX_IR_CORES,
                                       cs>>>(
      (const flagcxDevComm *)devCommPtr, devResult, true);
  irWait(cs, "S16 DevBarrierArriveWait INTER");
}
#endif

// ---------------------------------------------------------------------------
// S17: flagcxDevPut with team-resolved peers — primary team + WORLD
// Each combo writes one float into the peer's slot for this rank:
//   dstOffset = combo * maxRanks * sizeof(float) + rankInTeam * sizeof(float)
// ---------------------------------------------------------------------------
__global__ void kernelDevTeamResolutionUnifiedS(const flagcxDevComm *gComm,
                                                const flagcxDevMem *gDst,
                                                const flagcxDevMem *gSrc,
                                                int *result, bool useInter) {
  FLAGCX_IR_PROLOGUE(gComm);
  flagcxDevMem dst, src;
  GM2LM(gDst, &dst, sizeof(dst));
  GM2LM(gSrc, &src, sizeof(src));

  const int worldRank = comm.getRank();
  const int nRanks = comm.getSize();
  const int intraRank = comm.getIntraRank();
  const int intraSize = comm.getIntraSize();
  const IrPrimaryTeam primary = irPrimaryTeam(comm, useInter);
  int maxRanks = primary.size > nRanks ? primary.size : nRanks;

#define S17_COMBO(combo, teamKind, peer, rankInTeam, coopKind)                 \
  do {                                                                         \
    if (cluster_id() == 0 && irCoopActive(coopKind)) {                         \
      size_t dstOff = ((size_t)(combo) * (size_t)maxRanks +                    \
                       (size_t)(rankInTeam)) *                                 \
                      sizeof(float);                                           \
      flagcxDevPut(&comm, &dst, dstOff, &src, 0, sizeof(float), teamKind,      \
                   peer, contextId, coopKind, flagcxDeviceScopeSystem,         \
                   flagcxDeviceMemoryOrderRelease);                            \
    }                                                                          \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
  } while (0)

  S17_COMBO(0, primary.kind, (primary.rank + 1) % primary.size, primary.rank,
            FLAGCX_COOP_THREAD);
  S17_COMBO(1, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks, worldRank,
            FLAGCX_COOP_THREAD);
  S17_COMBO(2, primary.kind, (primary.rank + 1) % primary.size, primary.rank,
            FLAGCX_COOP_WARP);
  S17_COMBO(3, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks, worldRank,
            FLAGCX_COOP_WARP);
  S17_COMBO(4, primary.kind, (primary.rank + 1) % primary.size, primary.rank,
            FLAGCX_COOP_BLOCK);
  S17_COMBO(5, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks, worldRank,
            FLAGCX_COOP_BLOCK);

  // The INTER suite also checks that INTRA peer resolution uses the caller's
  // node-local mapping on a nonzero logical node.
  if (useInter)
    S17_COMBO(6, FLAGCX_TEAM_INTRA, (intraRank + 1) % intraSize, intraRank,
              FLAGCX_COOP_THREAD);

#undef S17_COMBO

  // Push the stores out, then make every rank wait for its peer's stores.
  flagcxDevFlush(&comm, contextId, FLAGCX_COOP_BLOCK,
                 flagcxDeviceMemoryOrderRelaxed);
  flagcxDevBarrierSync(&comm, primary.kind, cluster_id(), contextId,
                       FLAGCX_COOP_BLOCK, flagcxDeviceMemoryOrderAcqRel,
                       flagcxDeviceScopeSystem);
  flagcxDevFlush(&comm, contextId, FLAGCX_COOP_BLOCK,
                 flagcxDeviceMemoryOrderRelaxed);

  if (cluster_id() == 0 && core_id() == 0)
    result[0] = 1;
}

#if defined(__xpu_on_host__) || !defined(__xpu__)
void launchKernelDevTeamResolutionIntraWorldS(const void *devCommPtr,
                                              const void *dstMemPtr,
                                              const void *srcMemPtr,
                                              int *devResult,
                                              flagcxStream_t stream) {
  XPUStream cs = (XPUStream)(*(void **)stream);
  kernelDevTeamResolutionUnifiedS<<<FLAGCX_IR_CLUSTERS, FLAGCX_IR_CORES, cs>>>(
      (const flagcxDevComm *)devCommPtr, (const flagcxDevMem *)dstMemPtr,
      (const flagcxDevMem *)srcMemPtr, devResult, false);
  irWait(cs, "S17 DevTeamResolution");
}

void launchKernelDevTeamResolutionInterWorldS(const void *devCommPtr,
                                              const void *dstMemPtr,
                                              const void *srcMemPtr,
                                              int *devResult,
                                              flagcxStream_t stream) {
  XPUStream cs = (XPUStream)(*(void **)stream);
  kernelDevTeamResolutionUnifiedS<<<FLAGCX_IR_CLUSTERS, FLAGCX_IR_CORES, cs>>>(
      (const flagcxDevComm *)devCommPtr, (const flagcxDevMem *)dstMemPtr,
      (const flagcxDevMem *)srcMemPtr, devResult, true);
  irWait(cs, "S17 DevTeamResolution INTER");
}
#endif

// ---------------------------------------------------------------------------
// S18 sub-block A: flagcxDevPut — primary team + WORLD, 6 combos
// Region layout: combo `c` owns [c * bytes, (c + 1) * bytes).
// ---------------------------------------------------------------------------
__global__ void kernelDevPutUnifiedS(const flagcxDevComm *gComm,
                                     const flagcxDevMem *gDst,
                                     const flagcxDevMem *gSrc, int *result,
                                     int bytes, bool useInter) {
  FLAGCX_IR_PROLOGUE(gComm);
  flagcxDevMem dst, src;
  GM2LM(gDst, &dst, sizeof(dst));
  GM2LM(gSrc, &src, sizeof(src));

  const int worldRank = comm.getRank();
  const int nRanks = comm.getSize();
  const IrPrimaryTeam primary = irPrimaryTeam(comm, useInter);

  // Combos 0-3 are issued by cluster 0 alone; combos 4-5 split the payload
  // across clusters. The split is in float units so every fragment stays
  // 4-byte aligned, which keeps the peer stores on the word path.
  const size_t words = (size_t)bytes / sizeof(float);
  const size_t wordsPerCluster =
      (words + (size_t)cluster_num() - 1) / (size_t)cluster_num();
  const size_t myFirstWord = (size_t)cluster_id() * wordsPerCluster;
  const size_t myWords =
      myFirstWord < words
          ? (wordsPerCluster < words - myFirstWord ? wordsPerCluster
                                                  : words - myFirstWord)
          : 0;

#define S18_LEAD_COMBO(combo, teamKind, peer, coopKind)                        \
  do {                                                                         \
    if (cluster_id() == 0 && irCoopActive(coopKind)) {                         \
      size_t off = (size_t)(combo) * (size_t)bytes;                            \
      flagcxDevPut(&comm, &dst, off, &src, off, (size_t)bytes, teamKind, peer,  \
                   contextId, coopKind, flagcxDeviceScopeSystem,               \
                   flagcxDeviceMemoryOrderRelease);                            \
    }                                                                          \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
  } while (0)

#define S18_SPLIT_COMBO(combo, teamKind, peer)                                 \
  do {                                                                         \
    if (myWords > 0) {                                                         \
      size_t off = (size_t)(combo) * (size_t)bytes +                           \
                   myFirstWord * sizeof(float);                                \
      flagcxDevPut(&comm, &dst, off, &src, off, myWords * sizeof(float),        \
                   teamKind, peer, contextId, FLAGCX_COOP_BLOCK,               \
                   flagcxDeviceScopeSystem, flagcxDeviceMemoryOrderRelease);   \
    }                                                                          \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
  } while (0)

  S18_LEAD_COMBO(0, primary.kind, (primary.rank + 1) % primary.size,
                 FLAGCX_COOP_THREAD);
  S18_LEAD_COMBO(1, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
                 FLAGCX_COOP_THREAD);
  S18_LEAD_COMBO(2, primary.kind, (primary.rank + 1) % primary.size,
                 FLAGCX_COOP_WARP);
  S18_LEAD_COMBO(3, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
                 FLAGCX_COOP_WARP);
  S18_SPLIT_COMBO(4, primary.kind, (primary.rank + 1) % primary.size);
  S18_SPLIT_COMBO(5, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks);

#undef S18_LEAD_COMBO
#undef S18_SPLIT_COMBO

  flagcxDevFlush(&comm, contextId, FLAGCX_COOP_BLOCK,
                 flagcxDeviceMemoryOrderRelaxed);

  if (cluster_id() == 0 && core_id() == 0)
    result[0] = 1;
}

#if defined(__xpu_on_host__) || !defined(__xpu__)
void launchKernelDevPutIntraWorldS(const void *devCommPtr,
                                   const void *dstMemPtr,
                                   const void *srcMemPtr, int *devResult,
                                   size_t bytes, flagcxStream_t stream) {
  XPUStream cs = (XPUStream)(*(void **)stream);
  kernelDevPutUnifiedS<<<FLAGCX_IR_CLUSTERS, FLAGCX_IR_CORES, cs>>>(
      (const flagcxDevComm *)devCommPtr, (const flagcxDevMem *)dstMemPtr,
      (const flagcxDevMem *)srcMemPtr, devResult, (int)bytes, false);
  irWait(cs, "S18 DevPut");
}

void launchKernelDevPutInterWorldS(const void *devCommPtr,
                                   const void *dstMemPtr,
                                   const void *srcMemPtr, int *devResult,
                                   size_t bytes, flagcxStream_t stream) {
  XPUStream cs = (XPUStream)(*(void **)stream);
  kernelDevPutUnifiedS<<<FLAGCX_IR_CLUSTERS, FLAGCX_IR_CORES, cs>>>(
      (const flagcxDevComm *)devCommPtr, (const flagcxDevMem *)dstMemPtr,
      (const flagcxDevMem *)srcMemPtr, devResult, (int)bytes, true);
  irWait(cs, "S18 DevPut INTER");
}
#endif

// ---------------------------------------------------------------------------
// S18 sub-block B: flagcxDevPutValue — one uint64 per combo slot
// Expected value at slot c on the receiver: senderRank * 100 + c.
// ---------------------------------------------------------------------------
__global__ void kernelDevPutValueUnifiedS(const flagcxDevComm *gComm,
                                          const flagcxDevMem *gDst, int *result,
                                          bool useInter) {
  FLAGCX_IR_PROLOGUE(gComm);
  flagcxDevMem dst;
  GM2LM(gDst, &dst, sizeof(dst));

  const int worldRank = comm.getRank();
  const int nRanks = comm.getSize();
  const IrPrimaryTeam primary = irPrimaryTeam(comm, useInter);

#define S18_VALUE_COMBO(combo, teamKind, peer, coopKind)                        \
  do {                                                                         \
    if (cluster_id() == 0 && irCoopActive(coopKind)) {                         \
      flagcxDevPutValue(&comm, &dst, (size_t)(combo) * sizeof(uint64_t),       \
                        (uint64_t)(worldRank * 100 + (combo)), teamKind, peer,  \
                        contextId, coopKind, flagcxDeviceScopeSystem,          \
                        flagcxDeviceMemoryOrderRelease);                       \
    }                                                                          \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
  } while (0)

  S18_VALUE_COMBO(0, primary.kind, (primary.rank + 1) % primary.size,
                  FLAGCX_COOP_THREAD);
  S18_VALUE_COMBO(1, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
                  FLAGCX_COOP_THREAD);
  S18_VALUE_COMBO(2, primary.kind, (primary.rank + 1) % primary.size,
                  FLAGCX_COOP_WARP);
  S18_VALUE_COMBO(3, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
                  FLAGCX_COOP_WARP);
  S18_VALUE_COMBO(4, primary.kind, (primary.rank + 1) % primary.size,
                  FLAGCX_COOP_BLOCK);
  S18_VALUE_COMBO(5, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
                  FLAGCX_COOP_BLOCK);

#undef S18_VALUE_COMBO

  flagcxDevFlush(&comm, contextId, FLAGCX_COOP_BLOCK,
                 flagcxDeviceMemoryOrderRelaxed);

  if (cluster_id() == 0 && core_id() == 0)
    result[0] = 1;
}

#if defined(__xpu_on_host__) || !defined(__xpu__)
void launchKernelDevPutValueIntraWorldS(const void *devCommPtr,
                                        const void *dstMemPtr, int *devResult,
                                        size_t bytes, flagcxStream_t stream) {
  (void)bytes; // every combo writes a single uint64_t
  XPUStream cs = (XPUStream)(*(void **)stream);
  kernelDevPutValueUnifiedS<<<FLAGCX_IR_CLUSTERS, FLAGCX_IR_CORES, cs>>>(
      (const flagcxDevComm *)devCommPtr, (const flagcxDevMem *)dstMemPtr,
      devResult, false);
  irWait(cs, "S18 DevPutValue");
}

void launchKernelDevPutValueInterWorldS(const void *devCommPtr,
                                        const void *dstMemPtr, int *devResult,
                                        size_t bytes, flagcxStream_t stream) {
  (void)bytes;
  XPUStream cs = (XPUStream)(*(void **)stream);
  kernelDevPutValueUnifiedS<<<FLAGCX_IR_CLUSTERS, FLAGCX_IR_CORES, cs>>>(
      (const flagcxDevComm *)devCommPtr, (const flagcxDevMem *)dstMemPtr,
      devResult, true);
  irWait(cs, "S18 DevPutValue INTER");
}
#endif

// ---------------------------------------------------------------------------
// S20: signal-only round trip — primary team + WORLD
// One increment per cluster and per context, so each slot ends at 1 (leg A)
// and 5 (leg B).
// ---------------------------------------------------------------------------
__global__ void kernelDevSignalStandaloneUnifiedS(const flagcxDevComm *gComm,
                                                  int *result,
                                                  bool useInter) {
  FLAGCX_IR_PROLOGUE(gComm);

  const int worldRank = comm.getRank();
  const int nRanks = comm.getSize();
  const IrPrimaryTeam primary = irPrimaryTeam(comm, useInter);
  bool ok = true;

#define S20_RESET_AND_CHECK(slot, teamKind)                                    \
  do {                                                                         \
    if (core_id() == 0)                                                        \
      flagcxDevResetSignal(&comm, contextId, (flagcxDevSignal_t)(slot));       \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    if (core_id() == 0 &&                                                      \
        flagcxDevReadSignal(&comm, (flagcxDevSignal_t)(slot), 64, contextId,   \
                            flagcxDeviceMemoryOrderAcquire) != 0)              \
      ok = false;                                                              \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    flagcxDevBarrierSync(&comm, teamKind, cluster_id(), contextId,             \
                         FLAGCX_COOP_BLOCK, flagcxDeviceMemoryOrderAcqRel,     \
                         flagcxDeviceScopeSystem);                             \
  } while (0)

#define S20_EXPECT(slot, expected, coopKind, waitOrder)                        \
  do {                                                                         \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    if (irCoopActive(coopKind))                                                \
      flagcxDevWaitSignal(&comm, (flagcxDevSignal_t)(slot), expected, 64,      \
                          contextId, coopKind, waitOrder);                     \
    if (core_id() == 0 &&                                                      \
        flagcxDevReadSignal(&comm, (flagcxDevSignal_t)(slot), 64, contextId,   \
                            flagcxDeviceMemoryOrderAcquire) != (expected))     \
      ok = false;                                                              \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
  } while (0)

#define S20_COMBO(slot, teamKind, peer, coopKind, waitOrder)                   \
  do {                                                                         \
    S20_RESET_AND_CHECK(slot, teamKind);                                       \
    if (irCoopActive(coopKind))                                                \
      flagcxDevSignalInc(&comm, teamKind, peer, (flagcxDevSignal_t)(slot),     \
                         contextId, coopKind, flagcxDeviceScopeSystem);        \
    S20_EXPECT(slot, (uint64_t)1, coopKind, waitOrder);                        \
    S20_RESET_AND_CHECK(slot, teamKind);                                       \
    if (irCoopActive(coopKind))                                                \
      flagcxDevSignalAdd(&comm, teamKind, peer, (flagcxDevSignal_t)(slot),     \
                         (uint64_t)5, contextId, coopKind,                     \
                         flagcxDeviceScopeSystem);                             \
    S20_EXPECT(slot, (uint64_t)5, coopKind, waitOrder);                        \
  } while (0)

  S20_COMBO(0, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_THREAD, flagcxDeviceMemoryOrderRelaxed);
  S20_COMBO(1, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
            FLAGCX_COOP_THREAD, flagcxDeviceMemoryOrderAcquire);
  S20_COMBO(2, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_WARP, flagcxDeviceMemoryOrderSeqCst);
  S20_COMBO(3, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks, FLAGCX_COOP_WARP,
            flagcxDeviceMemoryOrderRelaxed);
  S20_COMBO(4, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_BLOCK, flagcxDeviceMemoryOrderSeqCst);
  S20_COMBO(5, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks, FLAGCX_COOP_BLOCK,
            flagcxDeviceMemoryOrderAcquire);

#undef S20_COMBO
#undef S20_EXPECT
#undef S20_RESET_AND_CHECK

  irPublish(result, ok);
}

#if defined(__xpu_on_host__) || !defined(__xpu__)
void launchKernelDevSignalStandaloneIntraWorldS(const void *devCommPtr,
                                                int *devResult,
                                                flagcxStream_t stream) {
  XPUStream cs = (XPUStream)(*(void **)stream);
  kernelDevSignalStandaloneUnifiedS<<<FLAGCX_IR_CLUSTERS, FLAGCX_IR_CORES,
                                      cs>>>(
      (const flagcxDevComm *)devCommPtr, devResult, false);
  irWait(cs, "S20 DevSignalStandalone");
}

void launchKernelDevSignalStandaloneInterWorldS(const void *devCommPtr,
                                                int *devResult,
                                                flagcxStream_t stream) {
  XPUStream cs = (XPUStream)(*(void **)stream);
  kernelDevSignalStandaloneUnifiedS<<<FLAGCX_IR_CLUSTERS, FLAGCX_IR_CORES,
                                      cs>>>(
      (const flagcxDevComm *)devCommPtr, devResult, true);
  irWait(cs, "S20 DevSignalStandalone INTER");
}
#endif

// ---------------------------------------------------------------------------
// S21: flagcxDevPut followed by a separate signal — primary team + WORLD
// Even slots use SignalInc (expect 1), odd slots SignalAdd(3) (expect 3).
// ---------------------------------------------------------------------------
__global__ void kernelDevPutSignalWaitUnifiedS(const flagcxDevComm *gComm,
                                               const flagcxDevMem *gDst,
                                               const flagcxDevMem *gSrc,
                                               int *result, int bytes,
                                               bool useInter) {
  FLAGCX_IR_PROLOGUE(gComm);
  flagcxDevMem dst, src;
  GM2LM(gDst, &dst, sizeof(dst));
  GM2LM(gSrc, &src, sizeof(src));

  const int worldRank = comm.getRank();
  const int nRanks = comm.getSize();
  const IrPrimaryTeam primary = irPrimaryTeam(comm, useInter);
  bool ok = true;

#define S21_COMBO(slot, teamKind, peer, expected)                              \
  do {                                                                         \
    if (core_id() == 0)                                                        \
      flagcxDevResetSignal(&comm, contextId, (flagcxDevSignal_t)(slot));       \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    flagcxDevBarrierSync(&comm, teamKind, cluster_id(), contextId,             \
                         FLAGCX_COOP_BLOCK, flagcxDeviceMemoryOrderAcqRel,     \
                         flagcxDeviceScopeSystem);                             \
    if (core_id() == 0) {                                                      \
      size_t off = (size_t)(slot) * (size_t)bytes;                             \
      flagcxDevPut(&comm, &dst, off, &src, off, (size_t)bytes, teamKind, peer,  \
                   contextId, FLAGCX_COOP_THREAD, flagcxDeviceScopeSystem,     \
                   flagcxDeviceMemoryOrderRelease);                            \
      if ((slot) % 2 == 0)                                                     \
        flagcxDevSignalInc(&comm, teamKind, peer, (flagcxDevSignal_t)(slot),   \
                           contextId, FLAGCX_COOP_THREAD,                      \
                           flagcxDeviceScopeSystem);                           \
      else                                                                     \
        flagcxDevSignalAdd(&comm, teamKind, peer, (flagcxDevSignal_t)(slot),   \
                           (uint64_t)3, contextId, FLAGCX_COOP_THREAD,         \
                           flagcxDeviceScopeSystem);                           \
    }                                                                          \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    flagcxDevWaitSignal(&comm, (flagcxDevSignal_t)(slot), expected, 64,        \
                        contextId, FLAGCX_COOP_BLOCK,                          \
                        flagcxDeviceMemoryOrderAcquire);                       \
    if (core_id() == 0 &&                                                      \
        flagcxDevReadSignal(&comm, (flagcxDevSignal_t)(slot), 64, contextId,   \
                            flagcxDeviceMemoryOrderAcquire) != (expected))     \
      ok = false;                                                              \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
  } while (0)

  S21_COMBO(0, primary.kind, (primary.rank + 1) % primary.size, (uint64_t)1);
  S21_COMBO(1, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks, (uint64_t)3);
  S21_COMBO(2, primary.kind, (primary.rank + 1) % primary.size, (uint64_t)1);
  S21_COMBO(3, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks, (uint64_t)3);
  S21_COMBO(4, primary.kind, (primary.rank + 1) % primary.size, (uint64_t)1);
  S21_COMBO(5, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks, (uint64_t)3);

#undef S21_COMBO

  irPublish(result, ok);
}

