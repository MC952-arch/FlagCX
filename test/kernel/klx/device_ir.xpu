// ---------------------------------------------------------------------------
// S25: signal shadow + flush — primary team + WORLD
// The shadow is local: raise it by 5, send 5 increments to the ring peer, then
// wait until the received total meets the shadow.
// ---------------------------------------------------------------------------
__global__ void kernelDevSignalShadowFlushUnifiedS(const flagcxDevComm *gComm,
                                                   int *result,
                                                   bool useInter) {
  FLAGCX_IR_PROLOGUE(gComm);

  const int worldRank = comm.getRank();
  const int nRanks = comm.getSize();
  const IrPrimaryTeam primary = irPrimaryTeam(comm, useInter);
  bool ok = true;

#define S25_COMBO(slot, teamKind, peer, coopKind)                              \
  do {                                                                         \
    if (core_id() == 0) {                                                      \
      flagcxDevResetSignal(&comm, contextId, (flagcxDevSignal_t)(slot));       \
      if (flagcxDevReadSignal(&comm, (flagcxDevSignal_t)(slot), 64, contextId, \
                              flagcxDeviceMemoryOrderAcquire) != 0)            \
        ok = false;                                                            \
    }                                                                          \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    flagcxDevBarrierSync(&comm, teamKind, cluster_id(), contextId,             \
                         FLAGCX_COOP_BLOCK, flagcxDeviceMemoryOrderAcqRel,     \
                         flagcxDeviceScopeSystem);                             \
    if (core_id() == 0) {                                                      \
      flagcxDevIncreaseSignalShadow(&comm, contextId,                          \
                                    (flagcxDevSignal_t)(slot), (uint64_t)5);   \
      for (int i = 0; i < 5; i++)                                              \
        flagcxDevSignalInc(&comm, teamKind, peer, (flagcxDevSignal_t)(slot),   \
                           contextId, FLAGCX_COOP_THREAD,                      \
                           flagcxDeviceScopeSystem);                           \
    }                                                                          \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    if (irCoopActive(coopKind))                                                \
      flagcxDevWaitSignalMeetShadow(&comm, contextId,                          \
                                    (flagcxDevSignal_t)(slot), 64, coopKind,   \
                                    flagcxDeviceMemoryOrderAcquire);           \
    if (core_id() == 0 &&                                                      \
        flagcxDevReadSignal(&comm, (flagcxDevSignal_t)(slot), 64, contextId,   \
                            flagcxDeviceMemoryOrderAcquire) != 5)              \
      ok = false;                                                              \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    flagcxDevFlush(&comm, contextId, FLAGCX_COOP_BLOCK,                        \
                   flagcxDeviceMemoryOrderAcquire);                            \
  } while (0)

  S25_COMBO(0, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_THREAD);
  S25_COMBO(1, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
            FLAGCX_COOP_THREAD);
  S25_COMBO(2, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_WARP);
  S25_COMBO(3, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks, FLAGCX_COOP_WARP);
  S25_COMBO(4, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_BLOCK);
  S25_COMBO(5, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks, FLAGCX_COOP_BLOCK);

#undef S25_COMBO

  irPublish(result, ok);
}

