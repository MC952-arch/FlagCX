// ---------------------------------------------------------------------------
// S22: flagcxDevPut_RSigInc / _RSigAdd — signal fused into the put
// ---------------------------------------------------------------------------
__global__ void kernelDevPutRSigUnifiedS(const flagcxDevComm *gComm,
                                         const flagcxDevMem *gDst,
                                         const flagcxDevMem *gSrc, int *result,
                                         int bytes, bool useInter) {
  FLAGCX_IR_PROLOGUE(gComm);
  flagcxDevMem dst, src;
  GM2LM(gDst, &dst, sizeof(dst));
  GM2LM(gSrc, &src, sizeof(src));

  const int worldRank = comm.getRank();
  const int nRanks = comm.getSize();
  const IrPrimaryTeam primary = irPrimaryTeam(comm, useInter);
  bool ok = true;

#define S22_COMBO(slot, teamKind, peer, expected)                              \
  do {                                                                         \
    if (core_id() == 0) {                                                      \
      flagcxDevResetSignal(&comm, contextId, (flagcxDevSignal_t)(slot));       \
      if (flagcxDevReadSignal(&comm, (flagcxDevSignal_t)(slot), 64, contextId, \
                              flagcxDeviceMemoryOrderAcquire) != 0)            \
        ok = false;                                                            \
    }                                                                          \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    flagcxDevBarrierSync(&comm, teamKind, cluster_id(), contextId,             \
                         FLAGCX_COOP_BLOCK, flagcxDeviceMemoryOrderAcqRel,     \
                         flagcxDeviceScopeSystem);                             \
    if (core_id() == 0) {                                                      \
      size_t off = (size_t)(slot) * (size_t)bytes;                             \
      if ((slot) % 2 == 0)                                                     \
        flagcxDevPut_RSigInc(&comm, &dst, off, &src, off, (size_t)bytes,        \
                             teamKind, peer, contextId, FLAGCX_COOP_THREAD,    \
                             flagcxDeviceScopeSystem,                          \
                             flagcxDeviceMemoryOrderRelease,                   \
                             (flagcxDevSignal_t)(slot));                       \
      else                                                                     \
        flagcxDevPut_RSigAdd(&comm, &dst, off, &src, off, (size_t)bytes,        \
                             teamKind, peer, contextId, FLAGCX_COOP_THREAD,    \
                             flagcxDeviceScopeSystem,                          \
                             flagcxDeviceMemoryOrderRelease,                   \
                             (flagcxDevSignal_t)(slot), (uint64_t)3);          \
    }                                                                          \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    flagcxDevWaitSignal(&comm, (flagcxDevSignal_t)(slot), expected, 64,        \
                        contextId, FLAGCX_COOP_BLOCK,                          \
                        flagcxDeviceMemoryOrderAcquire);                       \
    if (core_id() == 0 &&                                                      \
        flagcxDevReadSignal(&comm, (flagcxDevSignal_t)(slot), 64, contextId,   \
                            flagcxDeviceMemoryOrderAcquire) != (expected))     \
      ok = false;                                                              \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
  } while (0)

  S22_COMBO(0, primary.kind, (primary.rank + 1) % primary.size, (uint64_t)1);
  S22_COMBO(1, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks, (uint64_t)3);
  S22_COMBO(2, primary.kind, (primary.rank + 1) % primary.size, (uint64_t)1);
  S22_COMBO(3, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks, (uint64_t)3);
  S22_COMBO(4, primary.kind, (primary.rank + 1) % primary.size, (uint64_t)1);
  S22_COMBO(5, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks, (uint64_t)3);

#undef S22_COMBO

  irPublish(result, ok);
}

