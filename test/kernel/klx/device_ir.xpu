// ---------------------------------------------------------------------------
// S24: flagcxDevPutValue_RSigInc / _RSigAdd — scalar write plus fused signal
// ---------------------------------------------------------------------------
__global__ void kernelDevPutValueRSigUnifiedS(const flagcxDevComm *gComm,
                                              const flagcxDevMem *gDst,
                                              int *result, bool useInter) {
  FLAGCX_IR_PROLOGUE(gComm);
  flagcxDevMem dst;
  GM2LM(gDst, &dst, sizeof(dst));

  const int worldRank = comm.getRank();
  const int nRanks = comm.getSize();
  const IrPrimaryTeam primary = irPrimaryTeam(comm, useInter);
  bool ok = true;

#define S24_COMBO(slot, teamKind, peer, coopKind, expected)                    \
  do {                                                                         \
    if (core_id() == 0) {                                                      \
      flagcxDevResetSignal(&comm, contextId, (flagcxDevSignal_t)(slot));       \
      if (flagcxDevReadSignal(&comm, (flagcxDevSignal_t)(slot), 64, contextId, \
                              flagcxDeviceMemoryOrderAcquire) != 0)            \
        ok = false;                                                            \
    }                                                                          \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    flagcxDevBarrierSync(&comm, teamKind, cluster_id(), contextId,             \
                         FLAGCX_COOP_BLOCK, flagcxDeviceMemoryOrderAcqRel,     \
                         flagcxDeviceScopeSystem);                             \
    if (irCoopActive(coopKind)) {                                              \
      size_t off = (size_t)(slot) * sizeof(uint64_t);                          \
      uint64_t val = (uint64_t)(worldRank * 100 + (slot));                     \
      if ((slot) % 2 == 0)                                                     \
        flagcxDevPutValue_RSigInc(&comm, &dst, off, val, teamKind, peer,       \
                                  contextId, coopKind,                        \
                                  flagcxDeviceScopeSystem,                    \
                                  flagcxDeviceMemoryOrderRelease,             \
                                  (flagcxDevSignal_t)(slot));                 \
      else                                                                     \
        flagcxDevPutValue_RSigAdd(&comm, &dst, off, val, teamKind, peer,       \
                                  contextId, coopKind,                        \
                                  flagcxDeviceScopeSystem,                    \
                                  flagcxDeviceMemoryOrderRelease,             \
                                  (flagcxDevSignal_t)(slot), (uint64_t)3);    \
    }                                                                          \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
    flagcxDevWaitSignal(&comm, (flagcxDevSignal_t)(slot), expected, 64,        \
                        contextId, FLAGCX_COOP_BLOCK,                          \
                        flagcxDeviceMemoryOrderAcquire);                       \
    if (core_id() == 0 &&                                                      \
        flagcxDevReadSignal(&comm, (flagcxDevSignal_t)(slot), 64, contextId,   \
                            flagcxDeviceMemoryOrderAcquire) != (expected))     \
      ok = false;                                                              \
    flagcxCoopSyncS(FLAGCX_COOP_BLOCK);                                        \
  } while (0)

  S24_COMBO(0, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_THREAD, (uint64_t)1);
  S24_COMBO(1, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks,
            FLAGCX_COOP_THREAD, (uint64_t)3);
  S24_COMBO(2, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_WARP, (uint64_t)1);
  S24_COMBO(3, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks, FLAGCX_COOP_WARP,
            (uint64_t)3);
  S24_COMBO(4, primary.kind, (primary.rank + 1) % primary.size,
            FLAGCX_COOP_BLOCK, (uint64_t)1);
  S24_COMBO(5, FLAGCX_TEAM_WORLD, (worldRank + 1) % nRanks, FLAGCX_COOP_BLOCK,
            (uint64_t)3);

#undef S24_COMBO

  irPublish(result, ok);
}

