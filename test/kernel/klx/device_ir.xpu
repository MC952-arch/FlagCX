                                             const void *dstMemPtr,
                                             const void *srcMemPtr,
                                             int *devResult, size_t bytes,
                                             flagcxStream_t stream) {
  XPUStream cs = (XPUStream)(*(void **)stream);
  kernelDevPutSignalWaitUnifiedS<<<FLAGCX_IR_CLUSTERS, FLAGCX_IR_CORES, cs>>>(
      (const flagcxDevComm *)devCommPtr, (const flagcxDevMem *)dstMemPtr,
      (const flagcxDevMem *)srcMemPtr, devResult, (int)bytes, false);
