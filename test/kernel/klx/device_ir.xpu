                                                 flagcxStream_t stream) {
  XPUStream cs = (XPUStream)(*(void **)stream);
  kernelDevSignalShadowFlushUnifiedS<<<FLAGCX_IR_CLUSTERS, FLAGCX_IR_CORES,
                                       cs>>>(
      (const flagcxDevComm *)devCommPtr, devResult, false);
  irWait(cs, "S25 DevSignalShadowFlush");
}

