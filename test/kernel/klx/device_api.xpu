typedef struct flagcxDevCommInternal *flagcxDevComm_t;
typedef struct flagcxDevMemInternal *flagcxDevMem_t;

struct flagcxDevMemInternal {
  void *rawPtr;
};
struct flagcxDevCommInternal {
  int rank, nRanks;
  int intraRank, intraSize;
};

flagcxResult_t launchKernelIntraAllReduce(flagcxDevMem_t devMem, size_t count,
                                          flagcxDataType_t datatype,
                                          flagcxDevComm_t devComm,
                                          flagcxStream_t stream);

flagcxResult_t launchKernelNetOneSidedAlltoAll(flagcxDevMem_t sendMem,
                                               flagcxDevMem_t recvMem,
                                               size_t count,
                                               flagcxDataType_t datatype,
                                               flagcxDevComm_t devComm,
                                               flagcxStream_t stream);

namespace {

static long xshmemTileElems(int npes) {
  const long PUT_WIN_BYTES = 2L * 1024 * 1024 * 1024;
  long t = (PUT_WIN_BYTES / 2) / ((long)npes * (long)sizeof(float)) -
           (16L << 20);
  if (t < (1L << 20))
    t = (1L << 20);
  return t;
}

static long xshmemTileElems1launch(int npes) {
  const long PUT_WIN_ELEMS = (2L * 1024 * 1024 * 1024) / sizeof(float);
  long t = (PUT_WIN_ELEMS / 2) / npes - (16L << 20);
  if (t < (1L << 20))
    t = (1L << 20);
  return t;
}

struct XshmemScratch {
  float *workPing = nullptr;
  float *workPong = nullptr;
  uint64_t *signal = nullptr;
  long workElems = 0;
  int clusternum = 0;
  int npes = 0;
};

static XshmemScratch g_scratch;
static long g_seq = 0;

static int ensureScratch(long tileElems, int npes, int clusternum) {
  bool needWork = (g_scratch.workPing == nullptr) || (npes != g_scratch.npes) ||
                  (tileElems > g_scratch.workElems);
  bool needSig = (g_scratch.signal == nullptr) || (npes != g_scratch.npes) ||
                 (clusternum != g_scratch.clusternum);

  if (needWork) {
    if (g_scratch.workPing)
      xshmem_free(g_scratch.workPing);
    if (g_scratch.workPong)
      xshmem_free(g_scratch.workPong);
    g_scratch.workPing =
        (float *)xshmem_calloc((size_t)tileElems * npes, sizeof(float), 1024);
    g_scratch.workPong =
        (float *)xshmem_calloc((size_t)tileElems * npes, sizeof(float), 1024);
    if (!g_scratch.workPing || !g_scratch.workPong)
      return 1;
    g_scratch.workElems = tileElems;
  }
  if (needSig) {
    if (g_scratch.signal)
      xshmem_free(g_scratch.signal);
    g_scratch.signal = (uint64_t *)xshmem_calloc(
        (size_t)2 * clusternum * npes, sizeof(uint64_t), sizeof(uint64_t));
    if (!g_scratch.signal)
      return 1;
    g_scratch.clusternum = clusternum;
  }
  g_scratch.npes = npes;
  return 0;
}

}


static __device__ inline void
issueSegPuts(DeviceAPI::Net net, DeviceAPI::Team world,
             DeviceAPI::Window workWin, DeviceAPI::Window dataWin, int tlen,
             int stride, int rank, int nRanks, int clusterid, int clusternum,
             DeviceAPI::CoopBlock coop) {
  int start, end;
  partition(clusterid, clusternum, tlen, 1024 / (int)sizeof(float), &start,
            &end);
  for (int p = 0; p < nRanks; ++p) {
    net.put(world, p, workWin,
            ((size_t)rank * stride + start) * sizeof(float), dataWin,
            (size_t)start * sizeof(float),
            (size_t)(end - start) * sizeof(float), flagcxDevNet_None{},
            flagcxDevNet_None{}, coop, flagcxDevNet_None{},
            flagcxDeviceScopeThread, flagcxDeviceScopeDevice);
  }
}

static __device__ inline void
finishSegPuts(DeviceAPI::Net net, DeviceAPI::Team world, int seq, int rank,
              int nRanks, int clusterid, int clusternum,
              DeviceAPI::CoopBlock coop) {
  net.flush(coop, flagcxDeviceMemoryOrderAcqRel);

  uint64_t stamp = (uint64_t)seq + 1;
  int sigBase = (seq & 1) * clusternum * nRanks + clusterid * nRanks;
  for (int p = 0; p < nRanks; ++p) {
    flagcxDevNet_SignalAdd arrive;
    arrive.signal = (flagcxDevNetSignal_t)(sigBase + rank);
    arrive.value = stamp;
    net.signal(world, p, arrive, coop, flagcxDevNet_None{},
               flagcxDeviceScopeThread, flagcxDeviceScopeDevice);
  }
  coop.sync();
  for (int s = 0; s < nRanks; ++s) {
    net.waitSignal(coop, (flagcxDevNetSignal_t)(sigBase + s), stamp, 64,
                   flagcxDeviceMemoryOrderRelaxed);
  }
  coop.sync();
}

static __device__ inline void
reduceSeg(__global_ptr__ float *io_tile, __global_ptr__ float *work_buf,
          int tlen, int stride, int nRanks, int clusterid, int clusternum,
          int cid, int corenum, float *local_buf, int local_buf_bytes) {
  int start, end;
  partition(clusterid, clusternum, tlen, 1024 / (int)sizeof(float), &start,
            &end);

  int local_buf_len = local_buf_bytes / 2 / (int)sizeof(float);
  int half_buf_len = local_buf_bytes / 4 / (int)sizeof(float);
  float *data = local_buf;
  float *combined_values = local_buf + local_buf_len;

  int r_core_start, r_core_end;
  partition(cid, corenum, end - start, 64, &r_core_start, &r_core_end);
  r_core_start += start;
  r_core_end += start;

  for (int i = r_core_start; i < r_core_end; i += half_buf_len) {
    int ping = 0, pong = half_buf_len;
    int cur_data_len = min(half_buf_len, r_core_end - i);
    if (nRanks >= 1)
      GM2LM_ASYNC(work_buf + 0 * stride + i, combined_values,
                  cur_data_len * sizeof(float));
    if (nRanks >= 2)
      GM2LM_ASYNC(work_buf + 1 * stride + i, data + ping,
                  cur_data_len * sizeof(float));
    mfence();
    for (int p = 1; p < nRanks; p++) {
      if (p + 1 < nRanks)
        GM2LM_ASYNC(work_buf + (p + 1) * stride + i, data + pong,
                    cur_data_len * sizeof(float));
      float *src = data + ping;
      int vec_len = cur_data_len & ~31;
      for (int j = 0; j < vec_len; j += 32) {
        float32x16_t a_l = vload_lm_float32x16(src + j);
        float32x16_t a_h = vload_lm_float32x16(src + j + 16);
        float32x16_t b_l = vload_lm_float32x16(combined_values + j);
        float32x16_t b_h = vload_lm_float32x16(combined_values + j + 16);
        b_l = vvadd_float32x16(a_l, b_l);
        b_h = vvadd_float32x16(a_h, b_h);
        vstore_lm_float32x16(combined_values + j, b_l);
        vstore_lm_float32x16(combined_values + j + 16, b_h);
      }
      mfence_lm();
      for (int j = vec_len; j < cur_data_len; j++)
        combined_values[j] = src[j] + combined_values[j];
      mfence();
      ping = half_buf_len - ping;
      pong = half_buf_len - pong;
    }
    LM2GM(combined_values, io_tile + i, cur_data_len * sizeof(float));
  }
}

__global__ void flagcxXshmemInplace1kKernel(float *io_data, float *work_ping,
                                            float *work_pong, uint64_t *signal,
                                            void *state_h, int num_elems,
                                            int tile_elems, int seq_base) {
  int clusterid = cluster_id();
  int clusternum = cluster_num();
  int cid = core_id();
  int corenum = core_num();

  XSHMEM_DEVICE_INIT(state_h);
  int rank = xshmem_my_pe();
  int nRanks = xshmem_n_pes();
  XSHMEM_DEVICE_SET_FLOW_CONTROL_THRESHOLD(clusternum);

  __local__ __simd__ char reduce_lm[XSHMEMI_LOCAL_BUF_LEN];

  DeviceAPI::Comm comm;
  comm.rank = rank;
  comm.nRanks = nRanks;
  comm.intraRank = 0;
  comm.intraSize = 1;
  comm.intraTeam = -1;
  comm.interTeam = -1;
  comm.worldTeam = -1;
  comm.signalBuffer = signal;
  comm.signalCount = 2 * clusternum * nRanks;
  comm.counterBuffer = nullptr;
  comm.counterCount = 0;
  comm.shadowBuffer = nullptr;
  comm.gridSyncState = nullptr;
  comm.devStateHandle = state_h;
  DeviceAPI::Net net(comm, 0);
  DeviceAPI::CoopBlock coop;
  DeviceAPI::Team world;
  world.nRanks = nRanks;
  world.rank = rank;
  world.stride = 1;

  int stride = tile_elems < num_elems ? tile_elems : num_elems;

  DeviceAPI::Window pingWin, pongWin;
  pingWin.symBase = work_ping;
  pingWin.rawPtr = work_ping;
  pingWin.allocSize = (size_t)nRanks * (size_t)stride * sizeof(float);
  pongWin.symBase = work_pong;
  pongWin.rawPtr = work_pong;
  pongWin.allocSize = (size_t)nRanks * (size_t)stride * sizeof(float);

  {
    DeviceAPI::Window dataWin;
    dataWin.symBase = io_data;
    dataWin.rawPtr = io_data;
    dataWin.allocSize = (size_t)stride * sizeof(float);
    issueSegPuts(net, world, (seq_base & 1) ? pongWin : pingWin, dataWin,
                 stride, stride, rank, nRanks, clusterid, clusternum, coop);
  }

  int ti = 0;
  for (long t0 = 0; t0 < num_elems; t0 += tile_elems, ++ti) {
    int tlen = (int)((num_elems - t0 < tile_elems) ? (num_elems - t0)
                                                   : tile_elems);
    int seq = seq_base + ti;
    __global_ptr__ float *cur_buf = (seq & 1) ? work_pong : work_ping;

    finishSegPuts(net, world, seq, rank, nRanks, clusterid, clusternum, coop);

    long nt0 = t0 + tile_elems;
    if (nt0 < num_elems) {
      int ntlen = (int)((num_elems - nt0 < tile_elems) ? (num_elems - nt0)
                                                       : tile_elems);
      DeviceAPI::Window nextData;
      nextData.symBase = io_data + nt0;
      nextData.rawPtr = io_data + nt0;
      nextData.allocSize = (size_t)ntlen * sizeof(float);
      issueSegPuts(net, world, ((seq + 1) & 1) ? pongWin : pingWin, nextData,
                   ntlen, stride, rank, nRanks, clusterid, clusternum, coop);
    }

    reduceSeg(io_data + t0, cur_buf, tlen, stride, nRanks, clusterid,
              clusternum, cid, corenum, (float *)reduce_lm,
              (int)XSHMEMI_LOCAL_BUF_LEN);
  }
  return;
}

flagcxResult_t launchKernelIntraAllReduce(flagcxDevMem_t devMem, size_t count,
                                          flagcxDataType_t datatype,
                                          flagcxDevComm_t devComm,
                                          flagcxStream_t stream) {
  if (devComm == nullptr || devMem == nullptr)
    return flagcxInternalError;
  if (datatype != flagcxFloat32)
    return flagcxInvalidArgument;
  if (count == 0)
    return flagcxSuccess;

  float *buf = (float *)devMem->rawPtr;
  if (buf == nullptr)
    return flagcxInternalError;

  int npes = devComm->nRanks;
  if (npes <= 0)
    return flagcxInternalError;

  int clusternum = 12;
  int corenum = 16;

  XPUStream cs = (XPUStream)(*(void **)stream);
  void *state = xshmem_get_xshmemi_device_state_h();

  long tileElems = xshmemTileElems(npes);
  long slotElems = ((long)count < tileElems) ? (long)count : tileElems;
  if (ensureScratch(slotElems, npes, clusternum) != 0)
    return flagcxSystemError;

  {
    const unsigned long long C2C_WIN = 2ULL * 1024 * 1024 * 1024;
    char *base = (char *)buf;
    if ((char *)g_scratch.workPing < base)
      base = (char *)g_scratch.workPing;
    if ((char *)g_scratch.workPong < base)
      base = (char *)g_scratch.workPong;
    if ((char *)g_scratch.signal < base)
      base = (char *)g_scratch.signal;
    unsigned long long workBytes =
        (unsigned long long)g_scratch.workElems * npes * sizeof(float);
    unsigned long long endPing =
        (unsigned long long)((char *)g_scratch.workPing - base) + workBytes;
    unsigned long long endPong =
        (unsigned long long)((char *)g_scratch.workPong - base) + workBytes;
    unsigned long long endSig =
        (unsigned long long)((char *)g_scratch.signal - base) +
        (unsigned long long)2 * clusternum * npes * sizeof(uint64_t);
    if (endPing > C2C_WIN || endPong > C2C_WIN || endSig > C2C_WIN)
      return flagcxSystemError;
  }

  long maxPerLaunch = (0x7fffffffL / tileElems) * tileElems;
  for (long off = 0; off < (long)count; off += maxPerLaunch) {
    long n = (long)count - off;
    if (n > maxPerLaunch)
      n = maxPerLaunch;
    long ntiles = (n + tileElems - 1) / tileElems;
    int tileArg = (int)((n < tileElems) ? n : tileElems);
    flagcxXshmemInplace1kKernel<<<clusternum, corenum, cs>>>(
        buf + off, g_scratch.workPing, g_scratch.workPong, g_scratch.signal,
        state, (int)n, tileArg, (int)g_seq);
    g_seq += ntiles;
  }
  xpu_wait(cs);

  return flagcxSuccess;
}

__global__ void
flagcxXshmemAlltoall1launchKernel(float *send_data, float *recv_data,
                                  float *recv_stage, uint64_t *signal, int count,
                                  int tile_elems, int seq_base,
                                  void *xshmemi_device_state_h) {
  int clusterid = cluster_id();
  int clusternum = cluster_num();
  int cid = core_id();
  int corenum = core_num();

  XSHMEM_DEVICE_INIT(xshmemi_device_state_h);
  int rank = xshmem_my_pe();
  int nRanks = xshmem_n_pes();

  int sub_clusternum = clusternum / nRanks;
  int sub_clusterid = clusterid % sub_clusternum;
  int dst_pe = clusterid / sub_clusternum;
  XSHMEM_DEVICE_SET_FLOW_CONTROL_THRESHOLD(sub_clusternum);

  DeviceAPI::Comm comm;
  comm.rank = rank;
  comm.nRanks = nRanks;
  comm.intraRank = 0;
  comm.intraSize = 1;
  comm.intraTeam = -1;
  comm.interTeam = -1;
  comm.worldTeam = -1;
  comm.signalBuffer = signal;
  comm.signalCount = 2 * clusternum * nRanks;
  comm.counterBuffer = nullptr;
  comm.counterCount = 0;
  comm.shadowBuffer = nullptr;
  comm.gridSyncState = nullptr;
  comm.devStateHandle = xshmemi_device_state_h;
  DeviceAPI::Net net(comm, 0);
  DeviceAPI::CoopBlock coop;
  DeviceAPI::Team world;
  world.nRanks = nRanks;
  world.rank = rank;
  world.stride = 1;

  __local__ __simd__ char copy_lm[XSHMEMI_LOCAL_BUF_LEN];

  int stride = min(tile_elems, count);

  __global_ptr__ float *stage_ping = recv_stage;
  __global_ptr__ float *stage_pong = recv_stage + (long)stride * nRanks;

  DeviceAPI::Window dstWin, srcWin;
  srcWin.symBase = send_data;
  srcWin.rawPtr = send_data;
  srcWin.allocSize = (size_t)nRanks * (size_t)count * sizeof(float);
  dstWin.allocSize = (size_t)nRanks * (size_t)stride * sizeof(float);

  {
    int tlen0 = min(tile_elems, count);
    int s0, e0;
    partition(sub_clusterid, sub_clusternum, tlen0, 1024 / sizeof(float), &s0,
              &e0);
    dstWin.symBase = stage_ping;
    dstWin.rawPtr = stage_ping;
    net.put(world, dst_pe, dstWin, ((size_t)rank * stride + s0) * sizeof(float),
            srcWin, ((size_t)dst_pe * count + s0) * sizeof(float),
            (size_t)(e0 - s0) * sizeof(float), flagcxDevNet_None{},
            flagcxDevNet_None{}, coop, flagcxDevNet_None{},
            flagcxDeviceScopeThread, flagcxDeviceScopeDevice);
  }

  int ti = 0;
  for (int t0 = 0; t0 < count; t0 += tile_elems, ++ti) {
    int tlen = min(tile_elems, count - t0);
    int seq = seq_base + ti;
    __global_ptr__ float *cur_stage = (ti & 1) ? stage_pong : stage_ping;

    net.flush(coop, flagcxDeviceMemoryOrderAcqRel);

    int sigBase = (seq & 1) * sub_clusternum * nRanks + sub_clusterid * nRanks;
    uint64_t stamp = (uint64_t)seq + 1;
    flagcxDevNet_SignalAdd arrive;
    arrive.signal = (flagcxDevNetSignal_t)(sigBase + rank);
    arrive.value = stamp;
    net.signal(world, dst_pe, arrive, coop, flagcxDevNet_None{},
               flagcxDeviceScopeThread, flagcxDeviceScopeDevice);
    coop.sync();
    net.waitSignal(coop, (flagcxDevNetSignal_t)(sigBase + dst_pe), stamp, 64,
                   flagcxDeviceMemoryOrderRelaxed);
    coop.sync();

    int nt0 = t0 + tile_elems;
    if (nt0 < count) {
      int ntlen = min(tile_elems, count - nt0);
      int ns, ne;
      partition(sub_clusterid, sub_clusternum, ntlen, 1024 / sizeof(float), &ns,
                &ne);
      __global_ptr__ float *next_stage =
          ((ti + 1) & 1) ? stage_pong : stage_ping;
      dstWin.symBase = next_stage;
      dstWin.rawPtr = next_stage;
      net.put(world, dst_pe, dstWin,
              ((size_t)rank * stride + ns) * sizeof(float),
              srcWin, ((size_t)dst_pe * count + nt0 + ns) * sizeof(float),
              (size_t)(ne - ns) * sizeof(float), flagcxDevNet_None{},
              flagcxDevNet_None{}, coop, flagcxDevNet_None{},
              flagcxDeviceScopeThread, flagcxDeviceScopeDevice);
    }

    int start, end;
    partition(sub_clusterid, sub_clusternum, tlen, 1024 / sizeof(float), &start,
              &end);
    int buf_len = XSHMEMI_LOCAL_BUF_LEN / 2 / (int)sizeof(float);
    int r_core_start, r_core_end;
    partition(cid, corenum, end - start, 64, &r_core_start, &r_core_end);
    r_core_start += start;
    r_core_end += start;
    for (int i = r_core_start; i < r_core_end; i += buf_len) {
      int len = min(buf_len, r_core_end - i);
      GM2LM(cur_stage + dst_pe * stride + i, (float *)copy_lm,
            len * sizeof(float));
      LM2GM((float *)copy_lm, recv_data + (long)dst_pe * count + t0 + i,
            len * sizeof(float));
    }
  }
  return;
}

namespace {
struct XshmemA2AScratch {
  float *stage = nullptr;
  uint64_t *signal = nullptr;
  long stageElems = 0;
  int clusternum = 0;
  int npes = 0;
};
static XshmemA2AScratch g_a2a;
static long g_a2a_seq = 0;

static int ensureA2AScratch(long tileElems, int npes, int clusternum) {
  bool needStage = (g_a2a.stage == nullptr) || (npes != g_a2a.npes) ||
                   (tileElems > g_a2a.stageElems);
  bool needSig = (g_a2a.signal == nullptr) || (npes != g_a2a.npes) ||
                 (clusternum != g_a2a.clusternum);
  if (needStage) {
    if (g_a2a.stage)
      xshmem_free(g_a2a.stage);
    g_a2a.stage = (float *)xshmem_calloc((size_t)2 * tileElems * npes,
                                         sizeof(float), 1024);
    if (!g_a2a.stage)
      return 1;
    g_a2a.stageElems = tileElems;
  }
  if (needSig) {
    if (g_a2a.signal)
      xshmem_free(g_a2a.signal);
    g_a2a.signal = (uint64_t *)xshmem_calloc((size_t)2 * clusternum * npes,
                                             sizeof(uint64_t), sizeof(uint64_t));
    if (!g_a2a.signal)
      return 1;
    g_a2a.clusternum = clusternum;
  }
  g_a2a.npes = npes;
  return 0;
}
}

flagcxResult_t launchKernelNetOneSidedAlltoAll(flagcxDevMem_t sendMem,
                                               flagcxDevMem_t recvMem,
                                               size_t count,
                                               flagcxDataType_t datatype,
                                               flagcxDevComm_t devComm,
                                               flagcxStream_t stream) {
  if (devComm == nullptr || sendMem == nullptr || recvMem == nullptr)
    return flagcxInternalError;
  if (datatype != flagcxFloat32)
    return flagcxInvalidArgument;
  if (count == 0)
    return flagcxSuccess;

  float *send = (float *)sendMem->rawPtr;
  float *recv = (float *)recvMem->rawPtr;
  if (send == nullptr || recv == nullptr)
    return flagcxInternalError;

  int npes = devComm->nRanks;
  if (npes <= 0)
    return flagcxInternalError;

  int sub = 12 / npes;
  if (sub < 1)
    sub = 1;
  int clusternum = sub * npes;
  int corenum = 16;

  XPUStream cs = (XPUStream)(*(void **)stream);
  void *state = xshmem_get_xshmemi_device_state_h();

  long tileElems = xshmemTileElems1launch(npes);
  long firstTile = ((long)count < tileElems) ? (long)count : tileElems;
  if (ensureA2AScratch(firstTile, npes, clusternum) != 0)
    return flagcxSystemError;

  flagcxXshmemAlltoall1launchKernel<<<clusternum, corenum, cs>>>(
      send, recv, g_a2a.stage, g_a2a.signal, (int)count, (int)tileElems,
      (int)g_a2a_seq, state);
  long ntiles = ((long)count + tileElems - 1) / tileElems;
  g_a2a_seq += ntiles;

  return flagcxSuccess;
}

